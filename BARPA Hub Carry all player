-- [[ 1. THE KILL SWITCH (DOUBLE-CHECK SYSTEM) ]]
local GroupId = 35010872 
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json"

local function getSettings()
    -- Adding math.random AND os.time to stay ahead of the cache
    local finalURL = configURL .. "?t=" .. os.time() .. "&r=" .. math.random(1,100000)
    local success, res = pcall(function() return game:HttpGet(finalURL) end)
    if success then
        return HttpService:JSONDecode(res)
    end
    return nil
end

local function runSecurity()
    local config = getSettings()
    
    if config then
        -- If it says false, kick immediately
        if config.IsActive == false or config.IsActive == "false" then
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. (config.Reason or "Disabled by Luca_doncicz."))
            return false
        end
    end
    
    -- Group Check
    if not LocalPlayer:IsInGroup(GroupId) then
        pcall(function() GroupService:PromptJoinAsync(GroupId) end)
        LocalPlayer:Kick("\n[BARPA HUB]\nJoin the group to use this script!")
        return false
    end
    
    return true
end

-- Wait 1 second to let GitHub's cache breathe, then check
task.wait(1) 
