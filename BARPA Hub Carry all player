local LocalPlayer = Players.LocalPlayer

-- [[ 1. THE KILL SWITCH (STRICT CHECK) ]]
local GroupId = 35010872 
-- cacheBuster forces GitHub to send the NEWEST version of your file instantly
local cacheBuster = "?t=" .. math.random(1, 999999) 
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json" .. cacheBuster

local function runSecurityCheck()
    local success, configRes = pcall(function() 
        return game:HttpGet(configURL) 
    end)
    
    if success then
        local config = HttpService:JSONDecode(configRes)
        -- If it's false, we KICK and STOP the entire script here
        if config.IsActive == false or config.IsActive == "false" then
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. (config.Reason or "Disabled by Luca_doncicz."))
            return false
        end
    end
    
    -- [[ 2. GROUP LOCK ]]
    if not LocalPlayer:IsInGroup(GroupId) then
        pcall(function() GroupService:PromptJoinAsync(GroupId) end)
        LocalPlayer:Kick("\n[BARPA HUB]\nPlease join the group to use this script!")
        return false
    end
    
    return true
end

-- START SECURITY
if not runSecurityCheck() then 
    return -- This stops the rest of the code from ever running
end

