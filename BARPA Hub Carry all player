--// BARPA HUB v8.8 (Improved Security)

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

--// 1. PROTECTED GAME CHECK
local PROTECTED_PLACE_ID = 100249184794553

if game.PlaceId == PROTECTED_PLACE_ID then
    LocalPlayer:Kick("\n[SECURITY]\nExecution inside Barpa Hangout is not allowed.")
    return
end

--// 2. CONFIG
local GROUP_ID = 35010872
local CONFIG_URL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json?cache=" .. math.random(100000,999999)

--// 3. SECURITY FUNCTION
local function fetchConfig()
    local success, response = pcall(function()
        return game:HttpGet(CONFIG_URL)
    end)

    if not success then
        warn("[BARPA HUB] Failed to fetch config")
        return nil
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not ok then
        warn("[BARPA HUB] Invalid JSON config")
        return nil
    end

    return data
end

local function runSecurity()
    local config = fetchConfig()

    -- Kill switch
    if config then
        if not config.IsActive then
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. (config.Reason or "Script Disabled"))
            return false
        end
    else
        -- Optional: fail-safe (block if config fails)
        LocalPlayer:Kick("\n[BARPA HUB]\nConfig fetch failed.")
        return false
    end

    -- Group check
    if not LocalPlayer:IsInGroup(GROUP_ID) then
        pcall(function()
            GroupService:PromptJoinAsync(GROUP_ID)
        end)

        LocalPlayer:Kick("\n[BARPA HUB]\nJoin the group to use this script!")
        return false
    end

    return true
end

if not runSecurity() then return end

