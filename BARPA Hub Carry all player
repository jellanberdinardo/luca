-- 3. LOGIC
CarryBtn.MouseButton1Click:Connect(function()
    CarryBtn.Text = "EXECUTING..."
    
    local replic = ReplicatedStorage:FindFirstChild("CarryReplic")
    local remote = replic and replic.CarryRemotes:FindFirstChild("CarryRemote")
    local choice = replic and replic.CarryChoices:FindFirstChild("Piggyback")

    if remote and choice then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                task.spawn(function()
                    remote:FireServer({
                        ["cmd"] = "Carry",
                        ["firstPlr"] = p,
                        ["carrychoicesss"] = choice
                    })
                end)
            end
        end
        task.wait(0.5)
        CarryBtn.Text = "RAPID CARRY ALL"
    else
        CarryBtn.Text = "ERROR: FILES NOT FOUND"
    end
end)
