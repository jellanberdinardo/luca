-- [[ BARPA HUB v8.0 - SECURITY RESTORED ]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- [[ 1. THE KILL SWITCH & CONFIG ]]
local GroupId = 35010872 
local cacheBuster = "?t=" .. os.time()
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json" .. cacheBuster

local success, configRes = pcall(function() return game:HttpGet(configURL) end)
if success then
    local config = HttpService:JSONDecode(configRes)
    
    -- CHECK IF ACTIVE
    if config.IsActive == false then
        LocalPlayer:Kick("\n[BARPA HUB]\nThis script has been disabled by the creator.")
        return 
    end
    
    -- CHECK BLACKLIST (In case you find a leaker)
    if config.Blacklist and config.Blacklist[tostring(LocalPlayer.UserId)] then
        LocalPlayer:Kick("\n[BARPA HUB]\nYou are blacklisted from using this script.")
        return
    end
end

-- [[ 2. GROUP LOCK ]]
if not LocalPlayer:IsInGroup(GroupId) then
    pcall(function() GroupService:PromptJoinAsync(GroupId) end)
    LocalPlayer:Kick("\n[BARPA HUB]\nPlease join the group to use this script!")
    return
end

