    local choice = replic and replic.CarryChoices:FindFirstChild("Piggyback")

    if remote and choice then
        CarryBtn.Text = "EXECUTING..."
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                task.spawn(function()
                    remote:FireServer({
                        ["cmd"] = "Carry",
                        ["firstPlr"] = p,
                        ["carrychoicesss"] = choice
                    })
                end)
            end
        end
        task.wait(1)
        CarryBtn.Text = "RAPID CARRY ALL"
    end
