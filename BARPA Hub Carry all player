--// 5. LOGIC
local function getCarryRemote()
    local replic = ReplicatedStorage:FindFirstChild("CarryReplic")
    if not replic then return end

    local remote = replic:FindFirstChild("CarryRemotes")
    local choices = replic:FindFirstChild("CarryChoices")

    if not remote or not choices then return end

    return remote:FindFirstChild("CarryRemote"), choices:FindFirstChild("Piggyback")
end

CarryBtn.MouseButton1Click:Connect(function()
    local remote, choice = getCarryRemote()

    if not remote or not choice then
        warn("Carry system not found")
        return
    end

    CarryBtn.Text = "EXECUTING..."

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            task.spawn(function()
                pcall(function()
                    remote:FireServer({
                        cmd = "Carry",
                        firstPlr = player,
                        carrychoicesss = choice
                    })
                end)
            end)
        end
    end

    task.wait(1)
    CarryBtn.Text = "RAPID CARRY ALL"
end)
