-- [[ BARPA HUB v8.8 - ANTI-GAME EXECUTION ]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- [[ 1. THE PROTECTED GAME CHECK ]]
local ProtectedGameId = 100249184794553 -- Your Barpa Hangout ID

if game.PlaceId == ProtectedGameId then
    -- If they try to run it in your own game, they get kicked instantly.
    LocalPlayer:Kick("\n[SECURITY]\nYou cannot execute this script inside Barpa Hangout.")
    return 
end

-- [[ 2. CONFIG & KILL SWITCH ]]
local GroupId = 35010872 
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json?t=" .. os.time()

local function runSecurity()
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(configURL))
    end)
    
    if success and result then
        if result.IsActive == false or result.IsActive == "false" then
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. (result.Reason or "Disabled."))
            return false
        end
    end
    
    if not LocalPlayer:IsInGroup(GroupId) then
        pcall(function() GroupService:PromptJoinAsync(GroupId) end)
        LocalPlayer:Kick("\n[BARPA HUB]\nJoin the group to use this script!")
        return false
    end
    return true
end

if not runSecurity() then return end

