-- [[ BARPA HUB v8.6 - LOGIC & KICK FIX ]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- [[ 1. CONFIGURATION ]]
local GroupId = 35010872 
-- Double cache buster to ensure GitHub updates instantly
local cacheBuster = "?t=" .. os.time() .. "&r=" .. math.random(1,100000)
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json" .. cacheBuster

-- [[ 2. SECURITY CHECK ]]
local function runSecurity()
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(configURL))
    end)
    
    if success and result then
        -- THE FIX: Only kick if IsActive is false
        if result.IsActive == false or result.IsActive == "false" then
            -- Use the reason from JSON, or a default message if reason is "System is active"
            local kickMsg = result.Reason
            if kickMsg == "System is active." then
                kickMsg = "This script is currently disabled by Luca."
            end
            
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. kickMsg)
            return false
        end
    end
    
    -- Group Lock
    if not LocalPlayer:IsInGroup(GroupId) then
        pcall(function() GroupService:PromptJoinAsync(GroupId) end)
        LocalPlayer:Kick("\n[BARPA HUB]\nPlease join the group to use this script!")
        return false
    end
    
    return true
end

-- Run security check before loading GUI
if not runSecurity() then return end

