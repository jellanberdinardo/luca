-- [[ BARPA HUB v8.3 - JSON STABILITY FIX ]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- [[ 1. CONFIG & KILL SWITCH ]]
local GroupId = 35010872 
local configURL = "https://raw.githubusercontent.com/jellanberdinardo/luca/main/config.json?t=" .. os.time()

local function checkConfig()
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(configURL))
    end)
    
    if success and result then
        -- Only kick if it is EXPLICITLY set to false
        if result.IsActive == false or result.IsActive == "false" then
            LocalPlayer:Kick("\n[BARPA HUB]\n" .. (result.Reason or "Disabled by Luca_doncicz."))
            return false
        end
    else
        warn("[BARPA] JSON Error or GitHub Down. Defaulting to ACTIVE.")
    end
    return true
end

if not checkConfig() then return end

-- [[ 2. GROUP LOCK ]]
if not LocalPlayer:IsInGroup(GroupId) then
    pcall(function() GroupService:PromptJoinAsync(GroupId) end)
    LocalPlayer:Kick("\n[BARPA HUB]\nPlease join the group to use this script!")
    return
end

